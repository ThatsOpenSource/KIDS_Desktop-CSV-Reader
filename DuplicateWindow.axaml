<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KidsXmlToCsv.ViewModels"
        x:Class="KidsXmlToCsv.DuplicateWindow"
        x:DataType="vm:MainViewModel"
        Title="KIDS — Konflikte klären"
        Width="1280" Height="840"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        FontSize="14"
        Background="White">

  <Grid Margin="20" RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="Konflikte klären" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Die Schritte werden der Reihe nach abgearbeitet. Jeder Schritt wird erst freigeschaltet, wenn der vorherige vollständig geklärt ist." />
      <TextBlock Text="{Binding StageStatusText}" FontWeight="SemiBold" Foreground="#b8860b" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="0,12,0,0"
                SelectedIndex="{Binding CurrentTabIndex, Mode=TwoWay}">

      <!-- ============ 1. PersonIdentity ============ -->
      <TabItem IsEnabled="{Binding PersonIdentityStage.IsUnlocked}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="1. Doppel-Personen" />
            <TextBlock Text="{Binding PersonIdentityPager.TotalCount, StringFormat='({0})'}" Foreground="#6b6b6b" />
            <TextBlock Text="✓" Foreground="#1a7f37" FontWeight="Bold"
                       IsVisible="{Binding PersonIdentityStage.IsComplete}" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="Keine Doppel-Personen erkannt." Classes="muted"
                         IsVisible="{Binding PersonIdentityPager.IsEmpty}" />
              <ItemsControl ItemsSource="{Binding PersonIdentityPager.VisibleGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="{Binding HelpText}" Foreground="#6b6b6b" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding StatusText}" Foreground="#b8860b" FontStyle="Italic" />
                        </StackPanel>
                        <Border BorderBrush="#e6e6e6" BorderThickness="1" CornerRadius="3">
                          <StackPanel>
                            <Grid ColumnDefinitions="160,150,120,110,150,160,*" Background="#f6f6f6" Height="30">
                              <TextBlock Grid.Column="0" Text="LKID" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="Name" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="Geburtsdatum" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="3" Text="Klasse" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="4" Text="Schule" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="5" Text="Quelle" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="6" Text="Ergebnis" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Candidates}"
                                     SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" Padding="0">
                              <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="MinHeight" Value="0" />
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                              </ListBox.Styles>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="160,150,120,110,150,160,*" Height="32">
                                    <TextBlock Grid.Column="0" Text="{Binding Lkid}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding DobDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding ClassDisplayShort}" Padding="6,0" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding ClassDisplay}" />
                                    <TextBlock Grid.Column="4" Text="{Binding SchoolDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding SourceFileDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{Binding PreviewText}" Foreground="{Binding PreviewBrush}"
                                               Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Alle behalten (verschiedene Personen)"
                                  Command="{Binding SetKeepAllCommand}" Padding="10,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,8,0,0"
                      IsVisible="{Binding PersonIdentityPager.HasNext}">
            <Button Content="Zurück" Command="{Binding PersonIdentityPager.PreviousPageCommand}"
                    IsEnabled="{Binding PersonIdentityPager.HasPrevious}" />
            <TextBlock Text="{Binding PersonIdentityPager.PageLabel}" VerticalAlignment="Center" />
            <Button Content="Weiter" Command="{Binding PersonIdentityPager.NextPageCommand}"
                    IsEnabled="{Binding PersonIdentityPager.HasNext}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ 2. LKID ============ -->
      <TabItem IsEnabled="{Binding LkidStage.IsUnlocked}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="2. LKID" />
            <TextBlock Text="{Binding LkidPager.TotalCount, StringFormat='({0})'}" Foreground="#6b6b6b" />
            <TextBlock Text="✓" Foreground="#1a7f37" FontWeight="Bold"
                       IsVisible="{Binding LkidStage.IsComplete}" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="Keine LKID-Konflikte." Classes="muted"
                         IsVisible="{Binding LkidPager.IsEmpty}" />
              <ItemsControl ItemsSource="{Binding LkidPager.VisibleGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="{Binding HelpText}" Foreground="#6b6b6b" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding StatusText}" Foreground="#b8860b" FontStyle="Italic" />
                        </StackPanel>
                        <Border BorderBrush="#e6e6e6" BorderThickness="1" CornerRadius="3">
                          <StackPanel>
                            <Grid ColumnDefinitions="160,150,110,160,160,*" Background="#f6f6f6" Height="30">
                              <TextBlock Grid.Column="0" Text="LKID" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="Name" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="Klasse" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="3" Text="Schule" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="4" Text="Quelle" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="5" Text="Ergebnis" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Candidates}"
                                     SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" Padding="0">
                              <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="MinHeight" Value="0" />
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                              </ListBox.Styles>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="160,150,110,160,160,*" Height="32">
                                    <TextBlock Grid.Column="0" Text="{Binding Lkid}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClassDisplayShort}" Padding="6,0" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding ClassDisplay}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SchoolDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceFileDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PreviewText}" Foreground="{Binding PreviewBrush}"
                                               Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Alle verwerfen (nichts exportieren)"
                                  Command="{Binding SetDiscardAllCommand}" Padding="10,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,8,0,0"
                      IsVisible="{Binding LkidPager.HasNext}">
            <Button Content="Zurück" Command="{Binding LkidPager.PreviousPageCommand}"
                    IsEnabled="{Binding LkidPager.HasPrevious}" />
            <TextBlock Text="{Binding LkidPager.PageLabel}" VerticalAlignment="Center" />
            <Button Content="Weiter" Command="{Binding LkidPager.NextPageCommand}"
                    IsEnabled="{Binding LkidPager.HasNext}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ 3. Benutzername ============ -->
      <TabItem IsEnabled="{Binding UsernameStage.IsUnlocked}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="3. Benutzername" />
            <TextBlock Text="{Binding UsernamePager.TotalCount, StringFormat='({0})'}" Foreground="#6b6b6b" />
            <TextBlock Text="✓" Foreground="#1a7f37" FontWeight="Bold"
                       IsVisible="{Binding UsernameStage.IsComplete}" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="Keine Benutzernamen-Konflikte." Classes="muted"
                         IsVisible="{Binding UsernamePager.IsEmpty}" />
              <ItemsControl ItemsSource="{Binding UsernamePager.VisibleGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="{Binding HelpText}" Foreground="#6b6b6b" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding StatusText}" Foreground="#b8860b" FontStyle="Italic" />
                        </StackPanel>
                        <Border BorderBrush="#e6e6e6" BorderThickness="1" CornerRadius="3">
                          <StackPanel>
                            <Grid ColumnDefinitions="160,150,110,160,160,*" Background="#f6f6f6" Height="30">
                              <TextBlock Grid.Column="0" Text="LKID" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="Name" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="Klasse" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="3" Text="Aktuell" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="4" Text="Quelle" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="5" Text="Ergebnis" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Candidates}"
                                     SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" Padding="0">
                              <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="MinHeight" Value="0" />
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                              </ListBox.Styles>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="160,150,110,160,160,*" Height="32">
                                    <TextBlock Grid.Column="0" Text="{Binding Lkid}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClassDisplayShort}" Padding="6,0" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding ClassDisplay}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CurrentValue}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceFileDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PreviewText}" Foreground="{Binding PreviewBrush}"
                                               Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsKeepMode}">
                          <TextBlock Text="Andere Einträge:" VerticalAlignment="Center" Foreground="#6b6b6b" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="leeren"
                                       IsChecked="{Binding IsModeKeepAndBlank}" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="generieren"
                                       IsChecked="{Binding IsModeKeepAndGenerate}" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="Zeile verwerfen"
                                       IsChecked="{Binding IsModeKeepAndDisregard}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Alle generieren" Command="{Binding SetGenerateAllCommand}" Padding="10,4" />
                          <Button Content="Alle entfernen" Command="{Binding SetDiscardAllCommand}" Padding="10,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderBrush="#b3b3b3" BorderThickness="1,0,0,0" Padding="12,8,0,0"
                      IsVisible="{Binding HasEmptyUsernames}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding EmptyUsernameCount, StringFormat='Leere Benutzernamen ({0})'}"
                             FontWeight="SemiBold" />
                  <CheckBox Content="Für leere Einträge automatisch generieren"
                            IsChecked="{Binding GenerateEmptyUsernames}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,8,0,0"
                      IsVisible="{Binding UsernamePager.HasNext}">
            <Button Content="Zurück" Command="{Binding UsernamePager.PreviousPageCommand}"
                    IsEnabled="{Binding UsernamePager.HasPrevious}" />
            <TextBlock Text="{Binding UsernamePager.PageLabel}" VerticalAlignment="Center" />
            <Button Content="Weiter" Command="{Binding UsernamePager.NextPageCommand}"
                    IsEnabled="{Binding UsernamePager.HasNext}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ 4. Apple ID ============ -->
      <TabItem IsEnabled="{Binding AppleIdStage.IsUnlocked}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="4. Apple ID" />
            <TextBlock Text="{Binding AppleIdPager.TotalCount, StringFormat='({0})'}" Foreground="#6b6b6b" />
            <TextBlock Text="✓" Foreground="#1a7f37" FontWeight="Bold"
                       IsVisible="{Binding AppleIdStage.IsComplete}" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="Keine Apple-ID-Konflikte." Classes="muted"
                         IsVisible="{Binding AppleIdPager.IsEmpty}" />
              <ItemsControl ItemsSource="{Binding AppleIdPager.VisibleGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="{Binding HelpText}" Foreground="#6b6b6b" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding StatusText}" Foreground="#b8860b" FontStyle="Italic" />
                        </StackPanel>
                        <Border BorderBrush="#e6e6e6" BorderThickness="1" CornerRadius="3">
                          <StackPanel>
                            <Grid ColumnDefinitions="160,150,110,220,160,*" Background="#f6f6f6" Height="30">
                              <TextBlock Grid.Column="0" Text="LKID" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="Name" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="Klasse" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="3" Text="Aktuell" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="4" Text="Quelle" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="5" Text="Ergebnis" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Candidates}"
                                     SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" Padding="0">
                              <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="MinHeight" Value="0" />
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                              </ListBox.Styles>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="160,150,110,220,160,*" Height="32">
                                    <TextBlock Grid.Column="0" Text="{Binding Lkid}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClassDisplayShort}" Padding="6,0" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding ClassDisplay}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CurrentValue}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceFileDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PreviewText}" Foreground="{Binding PreviewBrush}"
                                               Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsKeepMode}">
                          <TextBlock Text="Andere Einträge:" VerticalAlignment="Center" Foreground="#6b6b6b" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="leeren"
                                       IsChecked="{Binding IsModeKeepAndBlank}" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="generieren"
                                       IsChecked="{Binding IsModeKeepAndGenerate}" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="Zeile verwerfen"
                                       IsChecked="{Binding IsModeKeepAndDisregard}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Alle generieren" Command="{Binding SetGenerateAllCommand}" Padding="10,4" />
                          <Button Content="Alle entfernen" Command="{Binding SetDiscardAllCommand}" Padding="10,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderBrush="#b3b3b3" BorderThickness="1,0,0,0" Padding="12,8,0,0"
                      IsVisible="{Binding HasEmptyAppleIds}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding EmptyAppleIdCount, StringFormat='Leere Apple IDs ({0})'}"
                             FontWeight="SemiBold" />
                  <CheckBox Content="Für leere Einträge automatisch generieren"
                            IsChecked="{Binding GenerateEmptyAppleIds}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,8,0,0"
                      IsVisible="{Binding AppleIdPager.HasNext}">
            <Button Content="Zurück" Command="{Binding AppleIdPager.PreviousPageCommand}"
                    IsEnabled="{Binding AppleIdPager.HasPrevious}" />
            <TextBlock Text="{Binding AppleIdPager.PageLabel}" VerticalAlignment="Center" />
            <Button Content="Weiter" Command="{Binding AppleIdPager.NextPageCommand}"
                    IsEnabled="{Binding AppleIdPager.HasNext}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ============ 5. System-E-Mail ============ -->
      <TabItem IsEnabled="{Binding SystemEmailStage.IsUnlocked}">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="5. System-E-Mail" />
            <TextBlock Text="{Binding SystemEmailPager.TotalCount, StringFormat='({0})'}" Foreground="#6b6b6b" />
            <TextBlock Text="✓" Foreground="#1a7f37" FontWeight="Bold"
                       IsVisible="{Binding SystemEmailStage.IsComplete}" />
          </StackPanel>
        </TabItem.Header>
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <TextBlock Text="Keine System-E-Mail-Konflikte." Classes="muted"
                         IsVisible="{Binding SystemEmailPager.IsEmpty}" />
              <ItemsControl ItemsSource="{Binding SystemEmailPager.VisibleGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="{Binding HelpText}" Foreground="#6b6b6b" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding StatusText}" Foreground="#b8860b" FontStyle="Italic" />
                        </StackPanel>
                        <Border BorderBrush="#e6e6e6" BorderThickness="1" CornerRadius="3">
                          <StackPanel>
                            <Grid ColumnDefinitions="160,150,110,220,160,*" Background="#f6f6f6" Height="30">
                              <TextBlock Grid.Column="0" Text="LKID" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="Name" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="2" Text="Klasse" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="3" Text="Aktuell" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="4" Text="Quelle" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="5" Text="Ergebnis" Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Candidates}"
                                     SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" Padding="0">
                              <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                  <Setter Property="Padding" Value="0" />
                                  <Setter Property="MinHeight" Value="0" />
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                              </ListBox.Styles>
                              <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid ColumnDefinitions="160,150,110,220,160,*" Height="32">
                                    <TextBlock Grid.Column="0" Text="{Binding Lkid}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ClassDisplayShort}" Padding="6,0" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding ClassDisplay}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CurrentValue}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding SourceFileDisplay}" Padding="6,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding PreviewText}" Foreground="{Binding PreviewBrush}"
                                               Padding="6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                  </Grid>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsKeepMode}">
                          <TextBlock Text="Andere Einträge:" VerticalAlignment="Center" Foreground="#6b6b6b" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="leeren"
                                       IsChecked="{Binding IsModeKeepAndBlank}" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="generieren"
                                       IsChecked="{Binding IsModeKeepAndGenerate}" />
                          <RadioButton GroupName="{Binding Key}_sub" Content="Zeile verwerfen"
                                       IsChecked="{Binding IsModeKeepAndDisregard}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Alle generieren" Command="{Binding SetGenerateAllCommand}" Padding="10,4" />
                          <Button Content="Alle entfernen" Command="{Binding SetDiscardAllCommand}" Padding="10,4" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderBrush="#b3b3b3" BorderThickness="1,0,0,0" Padding="12,8,0,0"
                      IsVisible="{Binding HasEmptySystemEmails}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding EmptySystemEmailCount, StringFormat='Leere System-E-Mails ({0})'}"
                             FontWeight="SemiBold" />
                  <CheckBox Content="Für leere Einträge automatisch generieren"
                            IsChecked="{Binding GenerateEmptySystemEmails}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" Margin="0,8,0,0"
                      IsVisible="{Binding SystemEmailPager.HasNext}">
            <Button Content="Zurück" Command="{Binding SystemEmailPager.PreviousPageCommand}"
                    IsEnabled="{Binding SystemEmailPager.HasPrevious}" />
            <TextBlock Text="{Binding SystemEmailPager.PageLabel}" VerticalAlignment="Center" />
            <Button Content="Weiter" Command="{Binding SystemEmailPager.NextPageCommand}"
                    IsEnabled="{Binding SystemEmailPager.HasNext}" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="Alle Standardwerte übernehmen"
              Command="{Binding AcceptAllDefaultsCommand}" />
      <Button Content="Rest verwerfen"
              Command="{Binding DiscardAllRemainingCommand}" />
      <Button Content="Schließen" Click="CloseButton_Click" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
